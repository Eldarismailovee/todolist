# Скопируйте в .env и поправьте под окружение.

# development | test | production. При production приложение отказывается
# стартовать с ключом по умолчанию, COOKIE_SECURE=false, OTP_LOG_CODES=true,
# ENABLE_TESTING_ENDPOINTS=true или пустым SMTP_HOST.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://todo:todo@127.0.0.1:55433/todo
REDIS_URL=redis://127.0.0.1:56379/0

# Префикс ключей и Pub/Sub каналов. Номер Redis DB не изолирует Pub/Sub,
# поэтому prod и test должны отличаться префиксом или использовать разные серверы.
REDIS_NAMESPACE=todo:dev

# SPA и API обслуживаются с одного origin; проверка точная.
ALLOWED_ORIGIN=http://localhost:5173

# TTL каждого выданного значения токена, секунды.
TOKEN_TTL_SECONDS=300
SESSION_ABSOLUTE_TTL_SECONDS=43200

# В локальной HTTP-разработке cookie не может быть Secure.
COOKIE_SECURE=false

# Служебные маршруты для e2e (чтение последнего кода подтверждения).
# В production ОБЯЗАТЕЛЬНО false: иначе код можно прочитать по HTTP.
ENABLE_TESTING_ENDPOINTS=false
OTP_LOG_CODES=false

# Ключ подписи OTP и ссылок на файлы. В production обязателен свой случайный
# ключ не короче 32 символов: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
